# Copy to .env locally. Never commit credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=high
ENABLE_PUBLIC_DATA=true
ENABLE_MIAOXIANG=false
ENABLE_CHOICE=false
MIAOXIANG_MCP_API_KEY=
MIAOXIANG_SKILLS_API_KEY=
MAX_TOOL_CALLS_PER_REQUEST=6
MAX_MODEL_ROUNDS=5
MAX_OUTPUT_TOKENS=16384
